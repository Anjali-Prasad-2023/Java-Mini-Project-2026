<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Complaints"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Report an issue with your room or rental."
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginBottom="25dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Submit a Complaint"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="15dp" />

        <EditText
            android:id="@+id/etComplaintTitle"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Complaint title"
            android:textSize="15sp"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:textColor="#000000"
            android:textColorHint="#444444"
            android:inputType="textCapSentences"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etComplaintRoomId"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Room ID"
            android:textSize="15sp"
            android:padding="14dp"
            android:background="#FFFFFF"
            android:textColor="#000000"
            android:textColorHint="#444444"
            android:inputType="text"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etComplaintDescription"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Describe your complaint..."
            android:textSize="15sp"
            android:padding="14dp"
            android:gravity="top"
            android:inputType="textMultiLine|textCapSentences"
            android:background="#FFFFFF"
            android:textColor="#000000"
            android:textColorHint="#444444"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSubmitComplaint"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="SUBMIT COMPLAINT"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#216B50"
            android:textAllCaps="false"
            android:layout_marginBottom="30dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Complaints"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/layoutComplaints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNoComplaints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No complaints submitted yet."
                android:textSize="15sp"
                android:textColor="#333333"
                android:gravity="center"
                android:padding="25dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
